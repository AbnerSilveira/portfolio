# Snyk policy — https://docs.snyk.io/manage-risk/policies/the-.snyk-file
version: v1.25.1
exclude:
  global:
    - apps/projects/sniffer/python/
ignore:
  SNYK-JS-OPENTELEMETRYCORE-17373280:
    - apps/web/package.json:
        reason: >-
          Transitive via contentlayer2 (build-time telemetry). Patch needs
          @opentelemetry/core 2.x which breaks the sdk-trace-base 1.x chain.
        expires: 2026-09-01T00:00:00.000Z
        created: 2026-06-23T00:00:00.000Z
  SNYK-JS-BRACEEXPANSION-16755174:
    - packages/config-eslint/package.json:
        reason: >-
          Dev-only ESLint toolchain; brace-expansion 5.x override breaks
          minimatch 3.x used by @eslint/config-array.
        expires: 2026-09-01T00:00:00.000Z
        created: 2026-06-23T00:00:00.000Z
