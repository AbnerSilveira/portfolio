{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        ".contentlayer/generated/**"
      ],
      "env": [
        "NODE_ENV",
        "RESEND_API_KEY",
        "CONTACT_FROM_EMAIL",
        "CONTACT_TO_EMAIL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SANDBOX_URL"
      ]
    },
    "@projects/sniffer-web#build": {
      "dependsOn": ["web#build", "^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
