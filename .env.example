NODE_ENV=development

# Desenvolvimento local (Docker Compose)
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
REDIS_URL=redis://localhost:6379

# Produção (NÃO commitar valores reais aqui)
#
# As connection strings do Neon devem existir apenas como secrets:
# - GitHub Actions: NEON_DATABASE_URL_MAIN / NEON_DATABASE_URL_TCC / NEON_DATABASE_URL_HONEYPOT / NEON_DATABASE_URL_THREAT_INTEL
# - Fly.io (ex.: sandbox-runner): DATABASE_URL apontando para o branch correto do Neon
# Vercel (apps/web)
# NEXT_PUBLIC_SITE_URL=https://...
# NEXT_PUBLIC_SNIFFER_API_URL=https://portfolio-sniffer-api.fly.dev
#
# Exemplos (placeholders — substitua no painel do provedor, não no git):
# NEON_DATABASE_URL_MAIN=postgresql://...
# NEON_DATABASE_URL_TCC=postgresql://...
# NEON_DATABASE_URL_HONEYPOT=postgresql://...
# NEON_DATABASE_URL_THREAT_INTEL=postgresql://...
